{
  "name": "IntakeShield",
  "version": "0.9.0",
  "vendor": "IntakeShield",
  "license": "GNU Affero General Public License v3.0 (AGPL-3.0)",
  "url": "https://github.com/Tranquillius/intakeshield",
  "change_log": [
    {
      "version": "0.1.0",
      "date": "2026-08-07 00:00:00 UTC",
      "log": "Initial version."
    },
    {
      "version": "0.3.5",
      "date": "2026-08-11 18:20:43 UTC",
      "log": "Add maximum account age setting, whitelist role removal, and hourly user cleanup scan."
    },
    {
      "version": "0.3.6",
      "date": "2026-08-11 18:46:07 UTC",
      "log": "Ensure max account age setting is created on upgrades; refresh settings UI from server."
    },
    {
      "version": "0.3.7",
      "date": "2026-08-11 18:56:50 UTC",
      "log": "Treat integer setting value 0 as valid (e.g. min_age_days=0) instead of falling back to defaults via .presence."
    },
    {
      "version": "0.3.8",
      "date": "2026-08-11 19:09:39 UTC",
      "log": "When disposable_domain weight meets the score threshold, skip candidate-role and ticket-count filters for blacklisted users; add IntakeShield.diagnose_user."
    },
    {
      "version": "0.3.9",
      "date": "2026-08-11 19:15:25 UTC",
      "log": "Make IntakeShield.diagnose_user public and include active whitelist/blacklist patterns in the diagnosis output."
    },
    {
      "version": "0.4.0",
      "date": "2026-08-13 11:43:18 UTC",
      "log": "Optional CAPTCHA on classic sign-up and password-reset requests (self-hosted ALTCHA or the form-channel provider). Skip ticket-only deletion when the customer is already a spam-user candidate so user deletion removes the tickets."
    },
    {
      "version": "0.4.1",
      "date": "2026-08-14 16:20:00 UTC",
      "log": "Serve the ALTCHA widget from the Zammad instance instead of jsdelivr so the default CSP no longer blocks sign-up and password-reset captchas."
    },
    {
      "version": "0.4.2",
      "date": "2026-08-14 16:48:00 UTC",
      "log": "Drop stale Taskbar/RecentView IDs before Data Privacy deletion; never score or auto-learn infrastructure and government domains as disposable; whitelist sync only writes and logs when role membership actually changes."
    },
    {
      "version": "0.4.3",
      "date": "2026-08-14 17:00:00 UTC",
      "log": "Solve the signup CAPTCHA on the main thread. Zammad's CSP blocks ALTCHA's blob/data Web Workers, which left the widget retrying challenges forever."
    },
    {
      "version": "0.5.0",
      "date": "2026-08-15 00:00:00 UTC",
      "log": "Optional inbound drop of mail from blacklist domains before Zammad creates a user or ticket. The original message still follows the e-mail channel keep-on-server setting. Signup CAPTCHA always uses self-hosted ALTCHA."
    },
    {
      "version": "0.6.0",
      "date": "2026-08-15 12:00:00 UTC",
      "log": "Optional scoring from gateway spam headers (SpamAssassin, Rspamd, Microsoft SCL) or a local daemon. The engines are not bundled. spam_engine is not added on top of an existing spam tag."
    },
    {
      "version": "0.7.0",
      "date": "2026-08-15 13:00:00 UTC",
      "log": "Optional switch to use the whitelist as an allow list for self-registration. Non-matching addresses are rejected on classic signup and GraphQL userSignup."
    },
    {
      "version": "0.8.0",
      "date": "2026-08-15 14:20:00 UTC",
      "log": "Group the admin UI into Filters, Spam, and Settings tabs. The master switch is the Settings header toggle."
    },
    {
      "version": "0.8.1",
      "date": "2026-08-15 12:35:00 UTC",
      "log": "Fix empty Filters and Spam admin pages and duplicated Settings tabs."
    },
    {
      "version": "0.8.2",
      "date": "2026-08-15 12:52:00 UTC",
      "log": "Show Filters and Spam help text under the nav tabs. Label the Settings master switch separately from the page heading."
    },
    {
      "version": "0.9.0",
      "date": "2026-09-04 00:00:00 UTC",
      "log": "Add Mark as spam to the classic Manage Users action menu. That blacklists the user's e-mail domain; matching accounts are queued by the spam-user scan."
    }
  ],
  "description": [
    {
      "language": "en",
      "text": "E-mail whitelist rules, optional signup allow list, inbound blacklist drop, optional gateway spam-engine scoring, signup CAPTCHA, mark-as-spam from Manage Users, and automated data privacy cleanup of spam users."
    },
    {
      "language": "de",
      "text": "E-Mail-Whitelist-Regeln, optionale Allow-Liste für die Selbstregistrierung, Verwerfen eingehender Blacklist-Mails, optionales Scoring über Gateway-Spam-Engines, Registrierungs-Captcha, Als-Spam-markieren in Manage Users und automatisierte Data-Privacy-Bereinigung von Spam-Benutzern."
    }
  ],
