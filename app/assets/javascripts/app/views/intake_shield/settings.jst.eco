<div class="page-header">
  <div class="page-header-title">
    <h1><%- @T('Settings') %> <small><%- @T('IntakeShield') %></small></h1>
  </div>
</div>

<div class="page-content">
  <h2><%- @T('Master Switch') %></h2>
  <p class="page-description"><%- @T('Enable or disable IntakeShield as a whole.') %></p>
  <div class="js-settings-master"></div>

  <div class="spacer"></div>

  <h2><%- @T('Whitelist') %></h2>
  <p class="page-description"><%- @T('Settings that control how trusted senders are handled.') %></p>
  <div class="js-settings-whitelist"></div>

  <div class="spacer"></div>

  <h2><%- @T('Spam Detection') %></h2>
  <p class="page-description"><%- @T('Settings for detecting spam users/tickets and scheduling deletions.') %></p>
  <div class="js-settings-spam"></div>

  <div class="spacer"></div>

  <h2><%- @T('Captcha') %></h2>
  <p class="page-description"><%- @T('Protect the classic sign-up form and password reset requests from automated abuse.') %></p>
  <div class="js-settings-captcha"></div>
</div>
